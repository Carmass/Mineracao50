FROM node:22-alpine AS base
RUN apk add --no-cache libc6-compat
WORKDIR /app

# ── Install dependencies ──────────────────────────────────────
FROM base AS deps
COPY package*.json turbo.json ./
COPY apps/web/package*.json ./apps/web/
RUN npm ci --frozen-lockfile

# ── Build ─────────────────────────────────────────────────────
FROM base AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
ENV NEXT_TELEMETRY_DISABLED=1
# Build only the web app via turbo
RUN npx turbo build --filter=@mineracao/web

# ── Production runner ─────────────────────────────────────────
# With outputFileTracingRoot pointing to the monorepo root,
# standalone output structure is:
#   apps/web/.next/standalone/
#     node_modules/        ← root deps traced in
#     apps/web/server.js   ← entry point
#     apps/web/.next/      ← server bundles
FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

RUN addgroup --system --gid 1001 nodejs \
 && adduser --system --uid 1001 nextjs

# Standalone bundle (contains node_modules + apps/web/server.js)
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next/standalone ./

# Static assets (.next/static must match the path server.js expects)
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next/static ./apps/web/.next/static

# Public folder
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/public ./apps/web/public

USER nextjs
EXPOSE 3000
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

CMD ["node", "apps/web/server.js"]
