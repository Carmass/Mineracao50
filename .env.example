# ============================================================
# MINERAÇÃO DE PRODUTOS - Environment Variables
# ============================================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# --- Upstash Redis ---
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token

# --- OpenAI ---
OPENAI_API_KEY=sk-your-openai-key
OPENAI_ORG_ID=org-your-org-id

# --- Stripe ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-key
STRIPE_SECRET_KEY=sk_test_your-key
STRIPE_WEBHOOK_SECRET=whsec_your-secret

# --- Mercado Pago ---
MERCADOPAGO_ACCESS_TOKEN=your-mp-token
MERCADOPAGO_WEBHOOK_SECRET=your-mp-webhook-secret

# --- Scraping Proxies ---
PROXY_PROVIDER_URL=http://your-proxy-provider.com
PROXY_USERNAME=your-proxy-user
PROXY_PASSWORD=your-proxy-pass
RESIDENTIAL_PROXY_LIST=proxy1:port:user:pass,proxy2:port:user:pass

# --- External APIs ---
SCRAPINGBEE_API_KEY=your-scrapingbee-key
BRIGHTDATA_ZONE=your-zone
BRIGHTDATA_PASSWORD=your-password

# --- Notifications ---
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
RESEND_API_KEY=re_your-resend-key

# --- Monitoring ---
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project
LOGTAIL_SOURCE_TOKEN=your-logtail-token
POSTHOG_API_KEY=phc_your-posthog-key

# --- Python Workers ---
WORKER_SECRET_KEY=your-worker-secret
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
